<Window x:Class="SdkPackageManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SdkPackageManager.App"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel
            Margin="30"
            VerticalAlignment="Center">

            <TextBlock
                Text="Native Interop Test"
                FontSize="24"
                Margin="0, 0, 0, 20" />

            <Button
                Content="Compare 1.2.0 with 1.4.0"
                Click="TestNative_Click"
                Width="220"
                Height="40"
                HorizontalAlignment="Left" />

            <TextBlock
                x:Name="NativeResultText"
                Text="Native result not tested yet."
                Margin="0, 20, 0, 0"
                FontSize="16" />
            
        </StackPanel>
    </Grid>
</Window>
