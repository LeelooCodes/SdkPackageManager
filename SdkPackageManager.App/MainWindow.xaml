<Window x:Class="SdkPackageManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Developer SDK Package Manager" 
        Height="450" 
        Width="850"
        MinHeight="400"
        MinWidth="700">
    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0, 0, 0, 20">

            <TextBlock
                Text="Developer SDK Package Manager"
                FontSize="26"
                FontWeight="SemiBold"/>

            <TextBlock Text="Manage installed developer packages and available updates."
                       Margin="0, 6, 0, 0"/>

        </StackPanel>

        <DataGrid x:Name="PackageGrid"
                  Grid.Row="1"
                  ItemsSource="{Binding Packages}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Package"
                                    Binding="{Binding Name}"
                                    Width="*"/>

                <DataGridTextColumn Header="Installed Version"
                                    Binding="{Binding InstalledVersion, TargetNullValue=-}"
                                    Width="160"/>

                <DataGridTextColumn Header="Available Version"
                                    Binding="{Binding AvailableVersion}"
                                    Width="160"/>

                <DataGridTextColumn Header="Status"
                                    Binding="{Binding StatusDisplay}"
                                    Width="160"/>

            </DataGrid.Columns>

        </DataGrid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0, 20, 0, 0">

            <Button
                Content="Install"
                Click="Install_Click"
                Width="100"
                Height="36"
                Margin="0, 0, 10, 0" />

            <Button
                Content="Update"
                Click="Update_Click"
                Width="100"
                Height="36"
                Margin="0, 0, 10, 0"/>

            <Button
                Content="Remove"
                Click="Remove_Click"
                Width="100"
                Height="36"
                Margin="0, 0, 10, 0"/>
            
        </StackPanel>

        <Border Grid.Row="3"
                Margin="0, 20, 0, 0"
                Padding="12"
                BorderThickness="1">

            <TextBlock x:Name="StatusMessageText"
                       Text="Ready."/>

        </Border>
        
    </Grid>
    
</Window>
